{
  "name": "pointwise-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "框选区域 WFS 道路/设施要素采集器（含本地模拟 WFS、分页、分块、版本合并）",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js & vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "test:e2e": "node --test test/e2e/wfs.contract.test.js",
    "test:browser": "vite build && node test/browser/e2e.ui.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
